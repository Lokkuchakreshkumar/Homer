# Your TypeSafe API Key (from https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Port to bind (Render automatically sets this)
PORT=8787

# Host to bind (0.0.0.0 for Render/Docker, 127.0.0.1 for local)
HOST=0.0.0.0

# Set to 1 to run offline mock mode without calling TypeSafe
JEV_FAKE=0
